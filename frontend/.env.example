# URL base da API REST (Node/Express) da Sala de Reunião.
# Copie este arquivo para ".env" e ajuste se o backend rodar em outra porta/host.
VITE_API_URL=http://localhost:3000

# Login com Microsoft Entra ID.
# Deixe os DOIS vazios para usar o MODO PRÉVIA (login simulado com usuários de teste).
# Preencha os dois para o login real: ID do diretório (tenant) e ID do aplicativo (client)
# do App registration no portal do Azure.
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_CLIENT_ID=
