# Configuração do SERVIDOR DA EMPRESA (docker-compose.prod.yml).
# No servidor, copie este arquivo para ".env" (na raiz do projeto) e preencha.
# O .env nunca vai para o GitHub: as senhas ficam só no servidor.

# Endereço que as pessoas digitam no navegador, sem "https://".
# Pode ser o IP (172.16.81.102) ou um nome criado pela TI (ex.: sala.green.local).
SERVIDOR_ENDERECO=172.16.81.102

# Senhas do MySQL. Use senhas NOVAS e fortes (a antiga vazou no backend.zip).
# Só letras e números evita problemas com caracteres especiais.
# Atenção: o MySQL grava estas senhas na PRIMEIRA subida. Trocar aqui depois
# não muda a senha do banco que já existe (veja o README).
DB_ROOT_PASSWORD=
DB_PASSWORD=

# IDs do App registration no Entra ID (o administrador do Azure passa).
# Directory (tenant) ID e Application (client) ID.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=

# Só para um teste rápido antes de ter os IDs: "sim" libera o login simulado.
# Qualquer pessoa entra com qualquer nome, então volte para "nao" depois.
PERMITIR_MODO_PREVIA=nao

# Portas do servidor (mude só se a 80 ou a 443 já estiverem em uso)
PORTA_HTTP=80
PORTA_HTTPS=443

# Backup automático do banco: horário diário e quantos dias guardar
BACKUP_HORA=02:00
BACKUP_DIAS=30
