# Configuração do Docker para TESTE LOCAL (docker-compose.yml).
# Copie este arquivo para ".env" na raiz do projeto e ajuste.
# No servidor da empresa use o .env.producao.example.

# Senha do root do MySQL que roda no container
DB_PASSWORD=troque_esta_senha

# Endereço da API visto pelo navegador. "/api" usa o mesmo endereço
# do site (o nginx repassa para o backend), então funciona de qualquer máquina.
VITE_API_URL=/api

# Login com Microsoft Entra ID (usados no frontend e no backend).
# Deixe os DOIS vazios para o MODO PRÉVIA (login simulado).
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
